						<Id>1796000000617</Id>
						<Name><![CDATA[prepararCamion]]></Name>
						<X>3020</X>
						<Y>40</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[c]]></Name>
							<Type><![CDATA[CamionRetiro]]></Type>
						</Parameter>
						<Body><![CDATA[asegurarEspacio(c);
c.jumpTo(camionEntradaX, camionEntradaY);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000618</Id>
						<Name><![CDATA[moverCamion]]></Name>
						<X>3020</X>
						<Y>62</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[c]]></Name>
							<Type><![CDATA[CamionRetiro]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[x]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[y]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Body><![CDATA[// Devuelve los minutos del trayecto: lo usa el Delay como tiempo de viaje
double metros = Math.hypot(x - c.getX(), y - c.getY()) / pxPorMetro;
c.setSpeed(velocidadCamion, MPS);
if (metros > 0.05) c.moveTo(x, y);
return metros / velocidadCamion / 60.0;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000619</Id>
						<Name><![CDATA[alLlegarCamion]]></Name>
						<X>3020</X>
						<Y>84</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[c]]></Name>
							<Type><![CDATA[CamionRetiro]]></Type>
						</Parameter>
						<Body><![CDATA[// Si otro camión todavía está cargando, este espera su turno en el andén
if (camionActual == null) iniciarCarga(c);
else colaCamiones.add(c);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000620</Id>
						<Name><![CDATA[iniciarCarga]]></Name>
						<X>3020</X>
						<Y>106</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[c]]></Name>
							<Type><![CDATA[CamionRetiro]]></Type>
						</Parameter>
						<Body><![CDATA[// Se carga lo que hay en el rack de stock al llegar; lo que entra después espera al próximo camión
camionActual = c;
cajasEnCamion = 0;
cajasPorCargar = esperaDespacho.size();
if (cajasPorCargar == 0) eventoSalidaCamion.restart(0);
else esperaDespacho.freeAll();]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000621</Id>
						<Name><![CDATA[cajaCargada]]></Name>
						<X>3020</X>
						<Y>128</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[// En un evento propio: la salida libera agentes de otros bloques
if (--cajasPorCargar <= 0) eventoSalidaCamion.restart(0);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000622</Id>
						<Name><![CDATA[despacharCamion]]></Name>
						<X>3020</X>
						<Y>150</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[if (camionActual == null) return;
enCamion.freeAll(); // las cajas se van con el camión
CamionRetiro c = camionActual;
camionActual = null;
cargandoCamion.free(c);
if (!colaCamiones.isEmpty()) iniciarCarga(colaCamiones.removeFirst());]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000623</Id>
						<Name><![CDATA[prepararCargador]]></Name>
						<X>3020</X>
						<Y>172</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[// Empleados de depósito (de los ya contados en costos), no forman parte de los operarios de línea
asegurarEspacio(o);
o.especialidad = Especialidad.Polivalente;
o.presente = true;
o.estado = 0;
o.setSpeed(velocidadOperario, MPS);
o.jumpTo(stockFrenteX - 20 + (contadorCargadores++ % 4) * 14, stockFrenteY + 26);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000624</Id>
						<Name><![CDATA[alTomarCargador]]></Name>
						<X>3020</X>
						<Y>194</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[b.cargador = o;
o.estado = 1;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000625</Id>
						<Name><![CDATA[caminarCargador]]></Name>
						<X>3020</X>
						<Y>216</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[x]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[y]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Body><![CDATA[// El cargador camina en línea recta; si ya retiró la caja, la lleva en la mano
Operario o = b.cargador;
double metros = Math.hypot(x - o.getX(), y - o.getY()) / pxPorMetro;
double minutos = metros / velocidadOperario / 60.0;
if (metros > 0.05) o.moveTo(x, y);
moverCaja(b, x, y, minutos);
o.estado = 1;
return minutos;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000626</Id>
						<Name><![CDATA[finCaminataCargador]]></Name>
						<X>3020</X>
						<Y>238</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[Operario o = b.cargador;
if (o.isMoving()) o.jumpTo(o.getTargetX(), o.getTargetY());
if (!b.cajaEnRack) {
	// Si la caja estaba al pie del rack, el cargador la levanta acá
	b.cajaAlPie = false;
	b.jumpTo(o.getX(), o.getY() + 6, alturaCajaEnMano);
}]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000627</Id>
						<Name><![CDATA[subirCaja]]></Name>
						<X>3020</X>
						<Y>260</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[// La caja queda apilada en la caja del camión
b.cargador.estado = 2;
int k = cajasEnCamion++;
b.jumpTo(andenX - 28 + (k % 8) * 8, andenY - 6 + (k / 8 % 2) * 8, 16 + (k / 16) * 8);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000649</Id>
						<Name><![CDATA[alLiberarCargador]]></Name>
						<X>3020</X>
						<Y>40</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[b.cargador.estado = 0;
b.cargador = null;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[boolean]]></ReturnType>
						<Id>1796000000642</Id>
						<Name><![CDATA[hayLugar]]></Name>
						<X>3020</X>
						<Y>40</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[s]]></Name>
							<Type><![CDATA[Storage]]></Type>
						</Parameter>
						<Body><![CDATA[// Cada celda de un Storage guarda una sola caja; se deja una de margen
return celdasLibres(s) > 1;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[boolean]]></ReturnType>
						<Id>1796000000644</Id>
						<Name><![CDATA[decidirRack]]></Name>
						<X>3020</X>
						<Y>84</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[s]]></Name>
							<Type><![CDATA[Storage]]></Type>
						</Parameter>
						<Body><![CDATA[// Se decide una sola vez por rack (AnyLogic puede evaluar dos veces la condición de un
// SelectOutput, y guardar la caja cambia las celdas libres antes de la segunda evaluación)
if (b.decisionRack == 0) b.decisionRack = hayLugar(s) ? 1 : 2;
return b.decisionRack == 1;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000645</Id>
						<Name><![CDATA[llegarAlRack]]></Name>
						<X>3020</X>
						<Y>106</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[pieX]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[pieY]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Body><![CDATA[// Si el rack estaba lleno la caja queda en el piso, delante de él. retirarDeRack no cambia hasta
// el próximo rack: lo usan los SelectOutput que deciden si hay que pasar por el Retrieve
b.decisionRack = 0;
b.retirarDeRack = b.cajaEnRack;
if (b.cajaEnRack) return;
b.cajaAlPie = true;
int k = contadorPie++;
b.jumpTo(pieX - 20 + (k % 6) * 8, pieY + (k / 6 % 3) * 8, (k / 18 % 4) * 8);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[int]]></ReturnType>
						<Id>1796000000656</Id>
