					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000183</Id>
						<Name><![CDATA[registrarOperario]]></Name>
						<X>2800</X>
						<Y>194</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[construirPlanta();
o.idOp = ops.size();
ops.add(o);
if (o.idOp < nPuestos) {
	// Titular de un puesto: su especialidad sale del tipo de puesto
	int p = o.idOp;
	o.puestoHabitual = p;
	o.lineaHabitual = pLinea[p];
	o.esReserva = false;
	o.especialidad = especialidadDeTipo(pTipo[p]);
	pTitular[p] = o.idOp;
} else {
	o.puestoHabitual = -1;
	o.lineaHabitual = -1;
	o.esReserva = true;
	o.especialidad = Especialidad.Polivalente;
}]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[int]]></ReturnType>
						<Id>1796000000184</Id>
						<Name><![CDATA[ofEjemplo]]></Name>
						<X>2800</X>
						<Y>216</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[of]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[m]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[// OF de ejemplo (reemplazar por OF reales de KRETZ cuando estén disponibles)
int[][] ejemplos = {
	{ 36, 50, 72, 48, 60 },   // OF 1: mezcla equilibrada
	{ 24, 72, 48, 36, 48 },   // OF 2: mucha REPORT LT (procesos largos)
	{ 48, 30, 96, 60, 72 }    // OF 3: alto volumen de equipos cortos
};
if (of == 0) {
	int[] propia = { cantidadAILA, cantidadREPORT, cantidadNOVEL, cantidadLURA, cantidadAURA };
	return propia[m];
}
if (of == 4) return ejemplos[(diaGlobal - 1) % 3][m];
return ejemplos[Math.max(1, Math.min(3, of)) - 1][m];]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
