						<Body><![CDATA[String u = nombre.toUpperCase();
if (u.contains("AILA")) return 0;
if (u.contains("REPORT")) return 1;
if (u.contains("NOVEL")) return 2;
if (u.contains("LURA")) return 3;
if (u.contains("AURA")) return 4;
return -1;]]></Body>
