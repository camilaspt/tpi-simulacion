						</Parameter>
						<Body><![CDATA[int p = b.puestoActual;
if (p >= 0) b.jumpTo(pX[p] - mesaOffset, pY[p], alturaMesa);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
