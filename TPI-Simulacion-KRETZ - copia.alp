					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000215</Id>
						<Name><![CDATA[recogerCaja]]></Name>
						<X>2800</X>
						<Y>634</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[// El operario sale del rack con la caja de materiales en la mano
b.cajaEnRack = false;
b.jumpTo(b.opActual.getX(), b.opActual.getY() + 6, alturaCajaEnMano);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000216</Id>
						<Name><![CDATA[moverCaja]]></Name>
						<X>2800</X>
						<Y>656</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[x]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[y]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[minutos]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Body><![CDATA[// La caja llega a las manos del operario al mismo tiempo que él: desde el rack la lleva
// encima; entre pasos viaja desde la mesa anterior. Mientras está en un rack o al pie no se mueve
if (b.cajaEnRack || b.cajaAlPie) return;
double metros = Math.hypot(x - b.getX(), y + 6 - b.getY()) / pxPorMetro;
if (metros <= 0.05 || minutos <= 0) {
	b.jumpTo(x, y + 6, alturaCajaEnMano);
	return;
}
b.setSpeed(metros / (minutos * 60), MPS);
b.moveTo(x, y + 6, alturaCajaEnMano);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
