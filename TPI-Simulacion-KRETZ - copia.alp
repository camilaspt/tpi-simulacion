						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[return costoHorasNormales() + costoHorasExtraTotal + costoReorganizacion;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000233</Id>
						<Name><![CDATA[utilizacion]]></Name>
						<X>3020</X>
						<Y>634</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[e]]></Name>
							<Type><![CDATA[Especialidad]]></Type>
						</Parameter>
						<Body><![CDATA[// Fracción del tiempo presente en que la especialidad trabaja o camina
double ocupado = 0, disponible = 0;
double transcurrido = simulacionTerminada ? 0 : time() - (enRecuperacion ? tInicioRecuperacion : tInicioJornada);
for (Operario o : ops) {
	if (o.especialidad != e) continue;
	ocupado += o.tOcupado + (o.estado != 0 ? time() - o.tInicioOcupado : 0);
	disponible += o.minPresente + (o.presente ? transcurrido : 0);
}
return disponible > 0 ? Math.min(1, ocupado / disponible) : 0;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000234</Id>
						<Name><![CDATA[anexarCSV]]></Name>
						<X>3020</X>
						<Y>656</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[archivo]]></Name>
							<Type><![CDATA[String]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[encabezado]]></Name>
							<Type><![CDATA[String]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[fila]]></Name>
							<Type><![CDATA[String]]></Type>
						</Parameter>
						<Body><![CDATA[// Separador ; y coma decimal, como Datos/*.csv (Excel con configuración argentina)
if (!guardarResultados) return;
try {
	java.io.File f = new java.io.File(archivo);
	if (f.getParentFile() != null) f.getParentFile().mkdirs();
	boolean nuevo = !f.exists() || f.length() == 0;
	try (java.io.PrintWriter w = new java.io.PrintWriter(new java.io.OutputStreamWriter(
			new java.io.FileOutputStream(f, true), java.nio.charset.StandardCharsets.UTF_8))) {
		if (nuevo) w.println(encabezado);
		w.println(fila);
	}
} catch (Exception e) {
	traceln("No se pudo escribir " + archivo + ": " + e.getMessage());
}]]></Body>
					</Function>
