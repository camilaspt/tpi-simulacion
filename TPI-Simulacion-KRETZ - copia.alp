							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[for (Operario o : ops)
	if (o.estado == 0) irALugarDelDia(o); // quien está trabajando termina su tarea donde está]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000206</Id>
						<Name><![CDATA[enviarPeaton]]></Name>
						<X>3020</X>
						<Y>40</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[x]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[y]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Body><![CDATA[// Cambia el destino del operario; el circuito peatonal (pedIr -> pedLlego -> pedEnPuesto) lo lleva
boolean cambia = Math.hypot(x - o.destX, y - o.destY) > 1;
o.destX = x;
o.destY = y;
if (!o.enPlanta) return; // pedEntrada lo ubica directamente en su destino
if (pedEnPuesto.contains(o)) {
	// Si lo espera una unidad hay que pasar por pedLlego para avisarle, aunque ya esté en el lugar
	if (cambia || o.balanzaEnCamino != null) pedEnPuesto.free(o);
} else if (cambia && pedIr.contains(o)) {
	pedIr.cancel(o); // sale por ccl y vuelve a pedIr con el destino nuevo
}]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[boolean]]></ReturnType>
						<Id>1796000000207</Id>
						<Name><![CDATA[llegoADestino]]></Name>
						<X>3020</X>
						<Y>62</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[return Math.hypot(o.getX() - o.destX, o.getY() - o.destY) < 0.5 * pxPorMetro;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000208</Id>
						<Name><![CDATA[alLlegarPeaton]]></Name>
						<X>3020</X>
						<Y>84</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[// El operario llegó a su destino: si una unidad lo esperaba, la unidad sigue su proceso
Balanza b = o.balanzaEnCamino;
if (b == null) return;
o.balanzaEnCamino = null;
if (!caminar.free(b)) traceln("Aviso: la unidad " + b.ordenLiberacion + " no estaba esperando a su operario.");]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000209</Id>
						<Name><![CDATA[liberarUnidadesOF]]></Name>
						<X>3020</X>
						<Y>106</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[java.util.ArrayList<Integer> orden = new java.util.ArrayList<Integer>();
Integer[] modelos = { 0, 1, 2, 3, 4 };
if (reglaSecuencia == 1)
	java.util.Arrays.sort(modelos, (a, b) -> Double.compare(tiempoTotalModelo(b), tiempoTotalModelo(a)));
else if (reglaSecuencia == 2)
	java.util.Arrays.sort(modelos, (a, b) -> Double.compare(tiempoTotalModelo(a), tiempoTotalModelo(b)));
if (reglaSecuencia == 3) {
	// Intercalado: un equipo de cada modelo por vuelta
	int[] resto = ofDia.clone();
	boolean quedan = true;
	while (quedan) {
		quedan = false;
		for (int m = 0; m < 5; m++)
			if (resto[m] > 0) {
				orden.add(m);
				resto[m]--;
				quedan = true;
			}
	}
} else {
	for (int m : modelos)
		for (int k = 0; k < ofDia[m]; k++) orden.add(m);
}
colaLiberacion.addAll(orden);
liberadasSemana += orden.size();
fuenteOF.inject(orden.size());]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000210</Id>
						<Name><![CDATA[prepararUnidad]]></Name>
						<X>3020</X>
						<Y>128</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[int m = colaLiberacion.isEmpty() ? 0 : colaLiberacion.removeFirst();
b.tipoModelo = m;
b.set_modelo(nombresModelo[m]);
b.paso = 0;
b.lineaArmado = -1;
b.lineaCF = -1;
b.tIngreso = time();
b.diaOF = diaGlobal;
b.ordenLiberacion = contadorLiberadas++;
enProceso++;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000211</Id>
						<Name><![CDATA[prioridad]]></Name>
						<X>3020</X>
						<Y>150</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[// Las unidades más avanzadas pasan primero; entre iguales se respeta el orden de liberación
return b.paso * 100000.0 - b.ordenLiberacion;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[boolean]]></ReturnType>
						<Id>1796000000212</Id>
						<Name><![CDATA[puestoSirvePaso]]></Name>
						<X>3020</X>
						<Y>172</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[p]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[tipo]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[num]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[if (pTipo[p] != tipo) return false;
// AILA 30KG tiene cuatro puestos de armado específicos; los puestos adicionales (num 0) son flexibles
if (tipo != T_ARMADO || num == 0 || pNum[p] == 0) return true;
return pNum[p] == ((num - 1) % nArmadoFijos) + 1;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[boolean]]></ReturnType>
						<Id>1796000000213</Id>
						<Name><![CDATA[lineaPuedeProcesar]]></Name>
						<X>3020</X>
						<Y>194</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[linea]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[m]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[faseArmado]]></Name>
							<Type><![CDATA[boolean]]></Type>
						</Parameter>
						<Body><![CDATA[for (int k = 0; k < recLen[m]; k++) {
	int t = recTipo[m][k];
	if ((t <= T_AJUSTE) != faseArmado) continue;
	boolean hay = false;
	for (int p = 0; p < nPuestos && !hay; p++)
		if (pLinea[p] == linea && pAtiende[p] >= 0 && puestoSirvePaso(p, t, recNum[m][k])) hay = true;
	if (!hay) return false;
}
return true;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[int]]></ReturnType>
						<Id>1796000000214</Id>
						<Name><![CDATA[puestoParaPaso]]></Name>
						<X>3020</X>
						<Y>216</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[int m = b.tipoModelo;
if (!o.presente || b.paso >= recLen[m]) return -1;
int t = recTipo[m][b.paso];
int n = recNum[m][b.paso];
int fase = t <= T_AJUSTE ? 0 : 1;
int fija = fase == 0 ? b.lineaArmado : b.lineaCF;
// Si la línea asignada quedó sin personal para terminar el equipo, se la puede reasignar
if (fija >= 0 && !lineaCapaz[fija][m][fase]) fija = -1;
for (int p : o.puestosAtendidos) {
	if (!puestoSirvePaso(p, t, n)) continue;
	if (fija >= 0 ? pLinea[p] != fija : !lineaCapaz[pLinea[p]][m][fase]) continue;
	return p;
}
return -1;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000215</Id>
						<Name><![CDATA[alTomarOperario]]></Name>
						<X>3020</X>
						<Y>238</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[int p = puestoParaPaso(b, o);
b.opActual = o;
b.puestoActual = p;
if (p >= 0) {
	if (pTipo[p] <= T_AJUSTE) b.lineaArmado = pLinea[p];
	else b.lineaCF = pLinea[p];
}
o.estado = 1;
o.puestoTrabajo = p;
o.tInicioOcupado = time();]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000216</Id>
						<Name><![CDATA[planificarDespuesDeTomar]]></Name>
						<X>3020</X>
						<Y>260</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[double espera = time() - b.tInicioEspera;
b.esperaTotal += espera;
// Espera en cola por tipo de puesto (identifica cuellos de botella)
int tipo = recTipo[b.tipoModelo][b.paso];
sumaEsperaTipo[tipo] += espera;
maxEsperaTipo[tipo] = Math.max(maxEsperaTipo[tipo], espera);
nEsperaTipo[tipo]++;
if (b.paso == 0) {
	// Primer paso: el mismo operario va al rack único de materiales y después a su puesto
	b.fase = 1;
	b.destX = lugarRackX(b.opActual);
	b.destY = lugarRackY(b.opActual);
} else {
	b.fase = 2;
	b.destX = pX[b.puestoActual];
	b.destY = pY[b.puestoActual];
}]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000217</Id>
						<Name><![CDATA[iniciarCaminata]]></Name>
						<X>3020</X>
						<Y>282</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[// La unidad queda en el Wait caminar hasta que su operario llega caminando (alLlegarPeaton);
// el tiempo de traslado sale de la simulación peatonal
Operario o = b.opActual;
b.tInicioCaminata = time();
o.estado = 1;
o.balanzaEnCamino = b;
enviarPeaton(o, b.destX, b.destY);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000218</Id>
						<Name><![CDATA[finCaminata]]></Name>
						<X>3020</X>
						<Y>304</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[double minutos = time() - b.tInicioCaminata;
b.tCaminata += minutos;
b.opActual.tCaminando += minutos;
caminataTotalMin += minutos;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000219</Id>
						<Name><![CDATA[tiempoAleatorio]]></Name>
						<X>3020</X>
						<Y>326</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[media]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Body><![CDATA[// Triangular asimétrica con la media de SAP: mín 0,8·m, moda 0,9·m, máx 1,3·m (para variabilidad 1)
double k = Math.max(0, Math.min(3, variabilidadTiempos));
if (k == 0 || media <= 0) return media;
return triangular(media * (1 - 0.2 * k), media * (1 + 0.3 * k), media * (1 - 0.1 * k));]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000220</Id>
						<Name><![CDATA[tiempoTarea]]></Name>
						<X>3020</X>
						<Y>348</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[return tiempoAleatorio(recTiempo[b.tipoModelo][b.paso]);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000221</Id>
						<Name><![CDATA[alLiberarOperario]]></Name>
						<X>3020</X>
						<Y>370</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[// Se ejecuta al entrar al Release, antes de que el operario quede libre
Operario o = b.opActual;
o.tOcupado += time() - o.tInicioOcupado;
o.estado = 0;
o.puestoTrabajo = -1;
irALugarDelDia(o); // por ejemplo, quien cubrió un puesto ayer vuelve al suyo
b.opActual = null;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[boolean]]></ReturnType>
						<Id>1796000000222</Id>
						<Name><![CDATA[registrarTerminada]]></Name>
						<X>3020</X>
						<Y>392</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[// Se llama desde la condicion de esPrimero, que AnyLogic puede evaluar dos veces:
// la unidad se registra una sola vez y despues se devuelve el mismo resultado
if (b.tIngresoRack > 0) return b.inspeccionar;
int m = b.tipoModelo;
enProceso--;
terminadasSemana++;
prodDia[m]++;
prodSemana[m]++;
prodTotal[m]++;
if (!enRecuperacion && b.diaOF == diaGlobal) {
	aTiempoDia[m]++;
	aTiempoTotal[m]++;
}
if (b.lineaArmado >= 0) unidadesLinea[b.lineaArmado]++;
if (b.lineaCF >= 0) unidadesLinea[b.lineaCF]++;
// Muestra de calidad: el primer equipo de cada modelo de la jornada se inspecciona enseguida
b.inspeccionar = prodDia[m] == 1;
b.posMuestra = b.inspeccionar ? 1 : 0;
b.tIngresoRack = time();
if (enRecuperacion && terminadasSemana >= liberadasSemana) eventoFinRecuperacion.restart(0);
return b.inspeccionar;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000223</Id>
						<Name><![CDATA[registrarPresencia]]></Name>
						<X>3020</X>
						<Y>414</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[minutos]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Body><![CDATA[for (Operario o : ops) if (o.presente) o.minPresente += minutos;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000224</Id>
						<Name><![CDATA[cerrarMuestras]]></Name>
						<X>3020</X>
						<Y>436</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[// Por cada modelo, el último equipo de la muestra de la jornada se inspecciona; el resto pasa a stock
Balanza[] ultimo = new Balanza[5];
for (int i = 0; i < rackCalidad.size(); i++) {
	Balanza b = rackCalidad.get(i);
	if (ultimo[b.tipoModelo] == null || b.tIngresoRack >= ultimo[b.tipoModelo].tIngresoRack) ultimo[b.tipoModelo] = b;
}
for (Balanza b : ultimo)
	if (b != null) {
		b.inspeccionar = true;
		b.posMuestra = 2;
	}
rackCalidad.freeAll();]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000225</Id>
						<Name><![CDATA[cerrarJornada]]></Name>
						<X>3020</X>
						<Y>458</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[int objetivo = 0, aTiempo = 0;
String detalle = "";
for (int m = 0; m < 5; m++) {
	objetivo += ofDia[m];
	aTiempo += aTiempoDia[m];
	int f = ofDia[m] - aTiempoDia[m];
	faltanteModelo[m] += f;
	if (f > 0) detalle += " " + abreviaturas[m] + ":" + f;
}
int faltante = objetivo - aTiempo;
faltanteSemana += faltante;
diasSimulados++;
if (faltante > 0) diasSinCumplir++;
if (ausentesHoy > 0) {
	diasConAusencias++;
	faltanteConAusencias += faltante;
} else {
	diasSinAusencias++;
	faltanteSinAusencias += faltante;
}
registrarPresencia(duracionTurnoMin);
historial.add(String.format("S%d %-9s OF %3d | a tiempo %3d (%3.0f%%) | faltan %3d%s | aus %d cob %d sin cubrir %d",
	semana + 1, nombreDia(dia), objetivo, aTiempo, objetivo > 0 ? 100.0 * aTiempo / objetivo : 100.0,
	faltante, detalle, ausentesHoy, coberturasHoy, vacantesCriticasHoy));
traceln(historial.get(historial.size() - 1));
cerrarMuestras();
dia++;
if (dia < diasPorSemana) iniciarJornada();
else iniciarRecuperacion();]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000226</Id>
						<Name><![CDATA[iniciarRecuperacion]]></Name>
						<X>3020</X>
						<Y>480</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[int pendientes = liberadasSemana - terminadasSemana;
if (pendientes <= 0) {
	pendientesSemana = 0;
	historial.add(String.format("S%d Fin de semana: no hace falta recuperar", semana + 1));
	traceln(historial.get(historial.size() - 1));
	finSemana();
	return;
}
// Jornada de recuperación: su OF es el faltante (unidades en proceso + sin iniciar)
enRecuperacion = true;
tInicioRecuperacion = time();
for (int m = 0; m < 5; m++) prodDia[m] = 0;
asignarAsistencia(probAusenciaFinDeSemana);
asignarCoberturas();
ubicarOperarios();
personasRecuperacion = 0;
for (Operario o : ops) if (o.presente) personasRecuperacion++;
pendientesInicioRecuperacion = pendientes;
eventoCierreJornada.restart(maxHorasRecuperacion * 60);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000227</Id>
						<Name><![CDATA[finRecuperacion]]></Name>
						<X>3020</X>
						<Y>502</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[if (!enRecuperacion) return;
eventoCierreJornada.reset();
eventoFinRecuperacion.reset();
double minutos = time() - tInicioRecuperacion;
double horasHombre = minutos / 60.0 * personasRecuperacion;
double costo = horasHombre * valorHoraNormal * recargoFinDeSemana;
registrarPresencia(minutos);
horasExtraTotal += horasHombre;
costoHorasExtraTotal += costo;
horasExtraSemana = horasHombre;
costoExtraSemana = costo;
pendientesSemana = pendientesInicioRecuperacion;
int sinRecuperar = liberadasSemana - terminadasSemana;
historial.add(String.format("S%d Fin de semana: %d pendientes, %d personas, %.1f h -> %.0f h-hombre ($ %,.0f)%s",
	semana + 1, pendientesInicioRecuperacion, personasRecuperacion, minutos / 60.0, horasHombre, costo,
	sinRecuperar > 0 ? " | quedan " + sinRecuperar + " para la semana siguiente" : ""));
traceln(historial.get(historial.size() - 1));
enRecuperacion = false;
cerrarMuestras();
finSemana();]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000228</Id>
						<Name><![CDATA[finSemana]]></Name>
						<X>3020</X>
						<Y>524</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[exportarSemana();
faltanteSemana = 0;
horasExtraSemana = 0;
costoExtraSemana = 0;
pendientesSemana = 0;
semana++;
liberadasSemana -= terminadasSemana; // lo no recuperado pasa a la semana siguiente
terminadasSemana = 0;
for (int m = 0; m < 5; m++) {
	ofSemana[m] = 0;
	prodSemana[m] = 0;
}
if (semana < semanasSimuladas) {
	dia = 0;
	iniciarJornada();
} else {
	simulacionTerminada = true;
	traceln(resumenTexto());
	exportarCorrida();
	if (detenerAlFinal) finishSimulation();
}]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000229</Id>
						<Name><![CDATA[alFinalizarInspeccion]]></Name>
						<X>3020</X>
						<Y>546</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[int m = b.tipoModelo;
inspeccionadas[m]++;
b.rechazada = randomTrue(probRechazo);
if (b.rechazada) rechazadas[m]++; // se registra; el retrabajo queda fuera del alcance]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000230</Id>
						<Name><![CDATA[alIngresarStock]]></Name>
						<X>3020</X>
						<Y>568</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[int m = b.tipoModelo;
enStock[m]++;
sumaTiempoSistema[m] += time() - b.tIngreso;
sumaEspera[m] += b.esperaTotal;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000231</Id>
						<Name><![CDATA[costoHorasNormales]]></Name>
						<X>3020</X>
						<Y>590</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[int empleados = nPuestos + operariosReserva + 1 + empleadosDeposito; // +1 inspector de calidad
return empleados * duracionTurnoMin / 60.0 * diasSimulados * valorHoraNormal;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
