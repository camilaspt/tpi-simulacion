					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[Color]]></ReturnType>
						<Id>1796000000249</Id>
						<Name><![CDATA[colorPuesto]]></Name>
						<X>3240</X>
						<Y>326</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[p]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[if (pAtiende[p] < 0 || pAtiende[p] >= ops.size()) return new Color(220, 70, 70); // vacante sin cubrir
Operario o = ops.get(pAtiende[p]);
boolean trabajando = o.puestoTrabajo == p && o.estado == 2;
if (pAtiende[p] != pTitular[p]) return trabajando ? new Color(245, 140, 30) : new Color(252, 211, 150); // cubierto
return trabajando ? new Color(34, 160, 80) : new Color(175, 225, 190); // trabajando / ocioso]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[String]]></ReturnType>
						<Id>1796000000250</Id>
						<Name><![CDATA[etiquetaPuesto]]></Name>
						<X>3240</X>
						<Y>348</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[p]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[String[] siglas = { "A", "AJ", "CF", "EM" };
return siglas[pTipo[p]] + (pTipo[p] == T_ARMADO && pNum[p] > 0 ? String.valueOf(pNum[p]) : "");]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[String]]></ReturnType>
						<Id>1796000000251</Id>
						<Name><![CDATA[nombreLinea]]></Name>
						<X>3240</X>
						<Y>370</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[l]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[if (l >= lineasArmado + lineasCF) return "";
return l < lineasArmado ? "ARM " + (l + 1) : "CF " + (l - lineasArmado + 1);]]></Body>
					</Function>
				</Functions>
