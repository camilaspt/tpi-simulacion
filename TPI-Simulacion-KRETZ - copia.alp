						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[StringBuilder s = new StringBuilder();
for (int m = 0; m < 5; m++)
	s.append(String.format("%-10s inspec. %3d | rechazos %2d | stock %5d | t. sistema %6.1f min | espera %6.1f min%n",
		nombresModelo[m], inspeccionadas[m], rechazadas[m], enStock[m],
		enStock[m] > 0 ? sumaTiempoSistema[m] / enStock[m] : 0, enStock[m] > 0 ? sumaEspera[m] / enStock[m] : 0));
return s.toString().trim();]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[String]]></ReturnType>
						<Id>1796000000255</Id>
						<Name><![CDATA[textoCostos]]></Name>
						<X>3240</X>
						<Y>194</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[return String.format("Jornadas %d | sin cumplir la OF %d (%.0f%%) | faltante acumulado %d u.%n",
		diasSimulados, diasSinCumplir, diasSimulados > 0 ? 100.0 * diasSinCumplir / diasSimulados : 0, sumar(faltanteModelo))
	+ (jornadasComparables() > 0
		? String.format("Efecto de las ausencias (mismo día de la semana): %+.1f u. de faltante por jornada (%d jornadas)%n",
			efectoAusencias(), jornadasComparables())
		: "Efecto de las ausencias: sin jornadas comparables todavía (hace falta el mismo día con y sin ausencias)\n")
	+ String.format("Horas extra de fin de semana %.1f h-hombre | costo (x%.1f) $ %,.0f%n",
		horasExtraTotal, recargoFinDeSemana, costoHorasExtraTotal)
	+ String.format("Horas normales $ %,.0f | reorganización $ %,.0f | COSTO TOTAL $ %,.0f",
		costoHorasNormales(), costoReorganizacion, costoTotal());]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[String]]></ReturnType>
						<Id>1796000000256</Id>
						<Name><![CDATA[textoHistorial]]></Name>
						<X>3240</X>
						<Y>216</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[StringBuilder s = new StringBuilder();
for (int i = Math.max(0, historial.size() - 10); i < historial.size(); i++) s.append(historial.get(i)).append('\n');
return historial.isEmpty() ? "Todavía no cerró ninguna jornada." : s.toString().trim();]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[String]]></ReturnType>
						<Id>1796000000257</Id>
						<Name><![CDATA[textoEscenario]]></Name>
						<X>3240</X>
						<Y>238</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[return String.format("%s (semilla %d) | OF %d | secuencia %d | %d+%d líneas | extra A/J/C/E %d/%d/%d/%d | reserva %d | coberturas entre especialidades: %s",
	nombreEscenario, semillaUsada, ofSeleccionada, reglaSecuencia, lineasArmado, lineasCF, extraArmadores, extraAjustadores, extraControladores,
	extraEmbaladores, operariosReserva, coberturaEntreEspecialidades ? "sí" : "no");]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[String]]></ReturnType>
						<Id>1796000000258</Id>
						<Name><![CDATA[resumenTexto]]></Name>
						<X>3240</X>
						<Y>260</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[StringBuilder s = new StringBuilder();
s.append("=== KRETZ | RESUMEN DEL ESCENARIO ===\n").append(textoEscenario()).append('\n');
s.append("--- Producción (última jornada) ---\n").append(textoOF()).append('\n');
s.append("--- Personal ---\n").append(textoPersonal()).append('\n');
s.append("--- Calidad y tiempos ---\n").append(textoCalidad()).append('\n');
s.append("--- Cumplimiento y costos ---\n").append(textoCostos()).append('\n');
s.append("--- Efecto de las ausencias (faltante medio por jornada, mismo día de la semana) ---\n").append(textoAusencias()).append('\n');
s.append("--- Historial ---\n");
for (String fila : historial) s.append(fila).append('\n');
s.append("=== FIN DEL RESUMEN ===");
return s.toString();]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[Color]]></ReturnType>
						<Id>1796000000259</Id>
						<Name><![CDATA[colorPuesto]]></Name>
						<X>3240</X>
						<Y>282</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[p]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[if (pAtiende[p] < 0 || pAtiende[p] >= ops.size()) return new Color(220, 70, 70); // vacante sin cubrir
Operario o = ops.get(pAtiende[p]);
boolean trabajando = o.puestoTrabajo == p && o.estado == 2;
if (pAtiende[p] != pTitular[p]) return trabajando ? new Color(245, 140, 30) : new Color(252, 211, 150); // cubierto
return trabajando ? new Color(34, 160, 80) : new Color(175, 225, 190); // trabajando / ocioso]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[String]]></ReturnType>
						<Id>1796000000260</Id>
						<Name><![CDATA[etiquetaPuesto]]></Name>
						<X>3240</X>
						<Y>304</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[p]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[// Las líneas ocupan varias columnas de mesas, así que cada mesa dice a qué línea pertenece
String[] siglas = { "A", "AJ", "CF", "EM" };
return nombreLinea(pLinea[p]) + " · " + siglas[pTipo[p]]
	+ (pTipo[p] == T_ARMADO && pNum[p] > 0 ? String.valueOf(pNum[p]) : "");]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[String]]></ReturnType>
						<Id>1796000000261</Id>
						<Name><![CDATA[nombreLinea]]></Name>
						<X>3240</X>
						<Y>326</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[l]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[if (l >= lineasArmado + lineasCF) return "";
return l < lineasArmado ? "ARM " + (l + 1) : "CF " + (l - lineasArmado + 1);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
