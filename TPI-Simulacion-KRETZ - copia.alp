					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000204</Id>
						<Name><![CDATA[irALugarDelDia]]></Name>
						<X>2800</X>
						<Y>656</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[// Ausentes a su zona, reservas libres a la suya y el resto a un puesto que atiende hoy
if (!o.presente) {
	enviarPeaton(o, lugarAusenteX(o), lugarAusenteY(o));
	return;
}
if (o.puestosAtendidos.isEmpty()) {
	enviarPeaton(o, lugarReservaX(o), lugarReservaY(o));
	return;
}
for (int p : o.puestosAtendidos)
	if (Math.hypot(o.destX - pX[p], o.destY - pY[p]) < 1) return; // ya está en uno de sus puestos
int p = o.puestosAtendidos.get(0);
enviarPeaton(o, pX[p], pY[p]);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
