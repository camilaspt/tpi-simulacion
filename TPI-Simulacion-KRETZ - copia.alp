						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[s]]></Name>
							<Type><![CDATA[Storage]]></Type>
						</Parameter>
						<Body><![CDATA[// Si el rack todavía no armó sus celdas (no guardó nada y no informa lugar), se toma su capacidad
int libres = s.nFreeCells();
if (libres <= 0 && s.size() == 0) libres = s.capacity();
return libres;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000701</Id>
						<Name><![CDATA[registrarRacks]]></Name>
						<X>3020</X>
						<Y>40</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[// Ocupación de los racks del depósito (% de celdas con caja), cada 10 minutos (pestaña Gráficos).
// En porcentaje, para comparar racks de distinto tamaño (materiales 60 celdas, calidad y stock 200)
dsRackMateriales.add(time(), ocupacionRack(almacenMateriales));
dsRackCalidad.add(time(), ocupacionRack(almacenCalidad));
dsRackStock.add(time(), ocupacionRack(almacenStock));
eventoMuestreoRacks.restart(10);]]></Body>
					</Function>
