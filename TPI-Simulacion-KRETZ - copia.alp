					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000188</Id>
						<Name><![CDATA[iniciarJornada]]></Name>
						<X>2800</X>
						<Y>304</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[// Los operarios los crea el ResourcePool y después entran como peatones a la planta;
// hasta que estén todos adentro se reintenta enseguida
if (ops.size() < nPuestos + operariosReserva || !operariosEnPlanta()) {
	eventoInicioJornada.restart(0.01);
	return;
}
enRecuperacion = false;
diaGlobal++;
tInicioJornada = time();
for (int m = 0; m < 5; m++) {
	ofDia[m] = ofEjemplo(ofSeleccionada, m);
	ofSemana[m] += ofDia[m];
	ofTotal[m] += ofDia[m];
	prodDia[m] = 0;
	aTiempoDia[m] = 0;
}
asignarAsistencia(Math.min(1, probAusencia * factorAusenciaDia[dia % 5]));
asignarCoberturas();
ubicarOperarios();
liberarUnidadesOF();
eventoCierreJornada.restart(duracionTurnoMin);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000189</Id>
						<Name><![CDATA[asignarAsistencia]]></Name>
						<X>2800</X>
						<Y>326</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[prob]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Body><![CDATA[ausentesHoy = 0;
for (Operario o : ops) {
	o.presente = !randomTrue(prob);
	if (!o.presente) ausentesHoy++;
}]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000190</Id>
						<Name><![CDATA[asignarCoberturas]]></Name>
						<X>2800</X>
						<Y>348</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[for (int p = 0; p < nPuestos; p++) pAtiende[p] = -1;
for (Operario o : ops) {
	o.puestosAtendidos.clear();
	if (o.presente && o.puestoHabitual >= 0) {
		pAtiende[o.puestoHabitual] = o.idOp;
		o.puestosAtendidos.add(o.puestoHabitual);
	}
}
vacantesHoy = 0;
coberturasHoy = 0;
vacantesCriticasHoy = 0;
for (int p = 0; p < nPuestos; p++) if (pAtiende[p] < 0) vacantesHoy++;
// Se cubren los puestos vacantes que frenan la línea (ningún otro puesto
// atendido de esa línea puede hacer la tarea). Quien cubre conserva su puesto
// y reparte su tiempo entre los dos: traslada el cuello de botella.
for (int p = 0; p < nPuestos; p++) {
	if (pAtiende[p] >= 0 || !esPuestoCritico(p)) continue;
	Operario c = buscarCobertura(p);
	if (c != null) {
		pAtiende[p] = c.idOp;
		c.puestosAtendidos.add(p);
		coberturasHoy++;
	} else {
		vacantesCriticasHoy++;
	}
}
coberturasTotal += coberturasHoy;
vacantesCriticasTotal += vacantesCriticasHoy;
if (!enRecuperacion) minutosVacantesTotal += (vacantesHoy - coberturasHoy) * duracionTurnoMin;
// Qué líneas pueden completar cada modelo con el personal de hoy
for (int l = 0; l < lineasArmado + lineasCF && l < lineaCapaz.length; l++)
	for (int m = 0; m < 5; m++) {
		lineaCapaz[l][m][0] = l < lineasArmado && lineaPuedeProcesar(l, m, true);
		lineaCapaz[l][m][1] = l >= lineasArmado && lineaPuedeProcesar(l, m, false);
	}
tomarOperario.recalculateResourceChoiceConditions();]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[boolean]]></ReturnType>
						<Id>1796000000191</Id>
						<Name><![CDATA[esPuestoCritico]]></Name>
						<X>2800</X>
						<Y>370</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[p]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[// Un puesto es crítico si ningún otro puesto atendido de su línea puede hacer su tarea
for (int q = 0; q < nPuestos; q++) {
	if (q == p || pAtiende[q] < 0 || pLinea[q] != pLinea[p] || pTipo[q] != pTipo[p]) continue;
	if (pTipo[p] != T_ARMADO || pNum[p] == 0 || pNum[q] == 0 || pNum[q] == pNum[p]) return false;
}
return true;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[boolean]]></ReturnType>
						<Id>1796000000192</Id>
						<Name><![CDATA[puedeCubrir]]></Name>
						<X>2800</X>
						<Y>392</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[return o.presente && !o.esReserva && !o.puestosAtendidos.isEmpty()
	&& o.puestosAtendidos.size() < maxPuestosPorOperario;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[int]]></ReturnType>
						<Id>1796000000193</Id>
						<Name><![CDATA[cargaCobertura]]></Name>
						<X>2800</X>
						<Y>414</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[// Menor es mejor: primero quien atiende menos puestos y cuyo puesto propio tiene respaldo
int carga = o.puestosAtendidos.size() * 2;
if (o.puestoHabitual >= 0 && esPuestoCritico(o.puestoHabitual)) carga++;
return carga;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[Operario]]></ReturnType>
						<Id>1796000000194</Id>
						<Name><![CDATA[mejorCandidato]]></Name>
						<X>2800</X>
						<Y>436</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[actual]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[candidato]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[if (actual == null) return candidato;
return cargaCobertura(candidato) < cargaCobertura(actual) ? candidato : actual;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[Operario]]></ReturnType>
						<Id>1796000000195</Id>
						<Name><![CDATA[buscarCobertura]]></Name>
						<X>2800</X>
						<Y>458</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[p]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[Especialidad e = especialidadDeTipo(pTipo[p]);
int linea = pLinea[p];
boolean lineaDeArmado = linea < lineasArmado;
// 0) Personal de reserva polivalente libre (no deja ningún puesto)
for (Operario o : ops)
	if (o.esReserva && o.presente && o.puestosAtendidos.isEmpty()) return o;
Operario mejor = null;
// 1) Misma especialidad y misma línea
for (Operario o : ops)
	if (puedeCubrir(o) && o.especialidad == e && o.lineaHabitual == linea) mejor = mejorCandidato(mejor, o);
if (mejor != null) return mejor;
// 2) Misma especialidad, otra línea del mismo tipo
for (Operario o : ops)
	if (puedeCubrir(o) && o.especialidad == e && (o.lineaHabitual < lineasArmado) == lineaDeArmado) mejor = mejorCandidato(mejor, o);
if (mejor != null) return mejor;
// 3) Los puestos de armado los puede cubrir cualquier operario (primero de la misma línea)
if (pTipo[p] == T_ARMADO || coberturaEntreEspecialidades) {
	for (Operario o : ops)
		if (puedeCubrir(o) && o.lineaHabitual == linea) mejor = mejorCandidato(mejor, o);
	if (mejor != null) return mejor;
	for (Operario o : ops)
		if (puedeCubrir(o)) mejor = mejorCandidato(mejor, o);
}
return mejor;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000196</Id>
						<Name><![CDATA[asegurarEspacio]]></Name>
						<X>2800</X>
						<Y>480</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[// El ResourcePool crea a los operarios sin espacio asignado; antes de entrar
// como peatones se los incorpora al espacio y nivel de Main
if (o.getSpace() == null) o.setSpace(this);
if (o.getLevel() == null) o.setLevel(level);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[boolean]]></ReturnType>
						<Id>1796000000197</Id>
						<Name><![CDATA[operariosEnPlanta]]></Name>
						<X>2800</X>
						<Y>502</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[// Cada operario entra una sola vez al espacio peatonal, directamente en su lugar habitual
boolean listos = true;
for (Operario o : ops) {
	if (o.enPlanta) continue;
	listos = false;
	if (o.ingresoPedido) continue;
	o.ingresoPedido = true;
	asegurarEspacio(o);
	if (o.puestoHabitual >= 0) {
		o.destX = pX[o.puestoHabitual];
		o.destY = pY[o.puestoHabitual];
	} else {
		o.destX = lugarReservaX(o);
		o.destY = lugarReservaY(o);
	}
	entrarPlanta.take(o);
}
return listos;]]></Body>
					</Function>
