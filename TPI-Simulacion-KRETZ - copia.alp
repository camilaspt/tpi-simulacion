						</Parameter>
						<Body><![CDATA[if (tipo == T_ARMADO) return Especialidad.Armador;
if (tipo == T_AJUSTE) return Especialidad.Ajustador;
if (tipo == T_CONTROL) return Especialidad.Controlador;
return Especialidad.Embalador;]]></Body>
