					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000220</Id>
						<Name><![CDATA[prioridad]]></Name>
						<X>3020</X>
						<Y>84</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[// Las unidades en una etapa más avanzada del proceso (armado < ajuste < control < embalaje) pasan
// primero; en la misma etapa, la más antigua. Se usa la etapa y no el número de paso, porque el
// número de paso no es comparable entre modelos (AILA tiene 4 pasos de armado; LURA, ninguno)
int m = b.tipoModelo;
int etapa = recTipo[m][Math.max(0, Math.min(b.paso, recLen[m] - 1))];
return etapa * 1000000.0 - b.ordenLiberacion;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[boolean]]></ReturnType>
						<Id>1796000000221</Id>
						<Name><![CDATA[puestoSirvePaso]]></Name>
						<X>3020</X>
						<Y>106</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[p]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[tipo]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[num]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[if (pTipo[p] != tipo) return false;
// AILA 30KG tiene cuatro puestos de armado específicos; los puestos adicionales (num 0) son flexibles
if (tipo != T_ARMADO || num == 0 || pNum[p] == 0) return true;
return pNum[p] == ((num - 1) % nArmadoFijos) + 1;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[boolean]]></ReturnType>
						<Id>1796000000222</Id>
						<Name><![CDATA[lineaPuedeProcesar]]></Name>
						<X>3020</X>
						<Y>128</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[linea]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[m]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[faseArmado]]></Name>
							<Type><![CDATA[boolean]]></Type>
						</Parameter>
						<Body><![CDATA[for (int k = 0; k < recLen[m]; k++) {
	int t = recTipo[m][k];
	if ((t <= T_AJUSTE) != faseArmado) continue;
	boolean hay = false;
	for (int p = 0; p < nPuestos && !hay; p++)
		if (pLinea[p] == linea && pAtiende[p] >= 0 && puestoSirvePaso(p, t, recNum[m][k])) hay = true;
	if (!hay) return false;
}
return true;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[int]]></ReturnType>
						<Id>1796000000223</Id>
						<Name><![CDATA[puestoParaPaso]]></Name>
						<X>3020</X>
						<Y>150</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[int m = b.tipoModelo;
if (!o.presente || b.paso >= recLen[m]) return -1;
int t = recTipo[m][b.paso];
int n = recNum[m][b.paso];
int fase = t <= T_AJUSTE ? 0 : 1;
int fija = fase == 0 ? b.lineaArmado : b.lineaCF;
// Si la línea asignada quedó sin personal para terminar el equipo, se la puede reasignar
if (fija >= 0 && !lineaCapaz[fija][m][fase]) fija = -1;
for (int p : o.puestosAtendidos) {
	if (!puestoSirvePaso(p, t, n)) continue;
	if (fija >= 0 ? pLinea[p] != fija : !lineaCapaz[pLinea[p]][m][fase]) continue;
	return p;
}
return -1;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000224</Id>
						<Name><![CDATA[alTomarOperario]]></Name>
						<X>3020</X>
						<Y>172</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[int p = puestoParaPaso(b, o);
b.opActual = o;
b.puestoActual = p;
if (p >= 0) {
	if (pTipo[p] <= T_AJUSTE) b.lineaArmado = pLinea[p];
	else b.lineaCF = pLinea[p];
}
o.estado = 1;
o.puestoTrabajo = p;
o.tInicioOcupado = time();]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000225</Id>
						<Name><![CDATA[planificarDespuesDeTomar]]></Name>
						<X>3020</X>
						<Y>194</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[double espera = time() - b.tInicioEspera;
// La espera de la unidad incluye, en el primer paso, la cola previa al rack de kits (desde que se
// liberó); la espera por tipo de puesto mide solo la espera de operario (cuellos de botella)
b.esperaTotal += b.paso == 0 ? time() - b.tIngreso : espera;
// Espera en cola por tipo de puesto (identifica cuellos de botella)
int tipo = recTipo[b.tipoModelo][b.paso];
sumaEsperaTipo[tipo] += espera;
maxEsperaTipo[tipo] = Math.max(maxEsperaTipo[tipo], espera);
nEsperaTipo[tipo]++;
if (b.paso == 0) {
	// Primer paso: el mismo operario va al rack único de materiales y después a su puesto
	b.fase = 1;
	planificarCaminata(b, rackX, rackY);
} else {
	b.fase = 2;
	planificarCaminata(b, pX[b.puestoActual], pY[b.puestoActual]);
}]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000226</Id>
						<Name><![CDATA[planificarCaminata]]></Name>
						<X>3020</X>
						<Y>216</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[destinoX]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[destinoY]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Body><![CDATA[b.tramos.clear();
Operario o = b.opActual;
boolean origenEnProduccion = o.getX() < paredNavesX;
boolean destinoEnProduccion = destinoX < paredNavesX;
// Entre naves se pasa por la puerta de la pared interna
if (origenEnProduccion != destinoEnProduccion) b.tramos.add(new double[] { puertaX, puertaY });
b.tramos.add(new double[] { destinoX, destinoY });]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000227</Id>
						<Name><![CDATA[iniciarTramo]]></Name>
						<X>3020</X>
						<Y>238</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[// El tramo se saca de la lista al empezar a caminar: asi la condicion de masTramos
// no cambia entre que se evalua y que la unidad sale del Delay
double[] destino = b.tramos.removeFirst();
Operario o = b.opActual;
double metros = Math.hypot(destino[0] - o.getX(), destino[1] - o.getY()) / pxPorMetro;
double minutos = metros / velocidadOperario / 60.0;
if (metros > 0.05) o.moveTo(destino[0], destino[1]);
moverCaja(b, destino[0], destino[1], minutos);
o.estado = 1;
b.tCaminata += minutos;
o.tCaminando += minutos;
caminataTotalMin += minutos;
return minutos;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000228</Id>
						<Name><![CDATA[finTramo]]></Name>
						<X>3020</X>
						<Y>260</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[// Asegura que el operario quede exactamente en el destino del tramo
Operario o = b.opActual;
if (o.isMoving()) o.jumpTo(o.getTargetX(), o.getTargetY());
if (!b.cajaEnRack) b.jumpTo(o.getX(), o.getY() + 6, alturaCajaEnMano);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000229</Id>
						<Name><![CDATA[tiempoAleatorio]]></Name>
						<X>3020</X>
						<Y>282</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[media]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Body><![CDATA[// Retiro de materiales e inspección: generador propio, separado de las ausencias y de las tareas
return tiempoConAzar(media, rngTiempos.nextDouble());]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000230</Id>
						<Name><![CDATA[tiempoTarea]]></Name>
						<X>3020</X>
						<Y>304</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[// El tiempo depende de la unidad (día, modelo y número dentro del modelo) y del paso, no del orden
// en que ocurren los eventos: la misma unidad tarda lo mismo en todos los escenarios
return tiempoConAzar(recTiempo[b.tipoModelo][b.paso],
	azar(3, b.diaOF, b.tipoModelo * 10000L + b.nroEnModelo, b.paso));]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000231</Id>
						<Name><![CDATA[alLiberarOperario]]></Name>
						<X>3020</X>
						<Y>326</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[// Se ejecuta al entrar al Release, antes de que el operario quede libre
Operario o = b.opActual;
o.tOcupado += time() - o.tInicioOcupado;
o.estado = 0;
o.puestoTrabajo = -1;
if (!o.presente) o.jumpTo(zonaAusentesX, zonaAusentesY);
b.opActual = null;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[boolean]]></ReturnType>
						<Id>1796000000232</Id>
						<Name><![CDATA[registrarTerminada]]></Name>
						<X>3020</X>
						<Y>348</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[// Se llama desde la condicion de esPrimero, que AnyLogic puede evaluar dos veces:
// la unidad se registra una sola vez y despues se devuelve el mismo resultado
if (b.tIngresoRack > 0) return b.inspeccionar;
int m = b.tipoModelo;
enProceso--;
enSistemaModelo[m]--;
terminadasSemana++;
prodDia[m]++;
prodSemana[m]++;
prodTotal[m]++;
if (!enRecuperacion && b.diaOF == diaGlobal) {
	aTiempoDia[m]++;
	aTiempoTotal[m]++;
}
if (b.lineaArmado >= 0) unidadesLinea[b.lineaArmado]++;
if (b.lineaCF >= 0) unidadesLinea[b.lineaCF]++;
// Muestra de calidad: el primer equipo de cada modelo de la jornada se inspecciona enseguida
b.inspeccionar = prodDia[m] == 1;
b.posMuestra = b.inspeccionar ? 1 : 0;
b.tIngresoRack = time();
if (enRecuperacion && terminadasSemana >= liberadasSemana) eventoFinRecuperacion.restart(0);
return b.inspeccionar;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000233</Id>
						<Name><![CDATA[registrarPresencia]]></Name>
						<X>3020</X>
						<Y>370</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[minutos]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Body><![CDATA[for (Operario o : ops) if (o.presente) o.minPresente += minutos;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000234</Id>
						<Name><![CDATA[cerrarMuestras]]></Name>
						<X>3020</X>
						<Y>392</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[// Por cada modelo, el último equipo de la muestra de la jornada se inspecciona; el resto pasa a stock
Balanza[] ultimo = new Balanza[5];
for (int i = 0; i < rackCalidad.size(); i++) {
	Balanza b = rackCalidad.get(i);
	if (ultimo[b.tipoModelo] == null || b.tIngresoRack >= ultimo[b.tipoModelo].tIngresoRack) ultimo[b.tipoModelo] = b;
}
for (Balanza b : ultimo)
	if (b != null) {
		b.inspeccionar = true;
		b.posMuestra = 2;
	}
rackCalidad.freeAll();]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000235</Id>
						<Name><![CDATA[cerrarJornada]]></Name>
						<X>3020</X>
						<Y>414</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[int objetivo = 0, aTiempo = 0;
String detalle = "";
for (int m = 0; m < 5; m++) {
	objetivo += ofDia[m];
	aTiempo += aTiempoDia[m];
	int f = ofDia[m] - aTiempoDia[m];
	faltanteModelo[m] += f;
	if (f > 0) detalle += " " + abreviaturas[m] + ":" + f;
}
int faltante = objetivo - aTiempo;
faltanteSemana += faltante;
diasSimulados++;
dsOFJornada.add(diasSimulados, objetivo);
dsATiempoJornada.add(diasSimulados, aTiempo);
if (faltante > 0) diasSinCumplir++;
// Para medir el efecto de las ausencias se compara contra el mismo día de la semana
int grupoAus = vacantesHoy > 0 ? 0 : 1;
faltanteDiaAus[dia % 7][grupoAus] += faltante;
jornadasDiaAus[dia % 7][grupoAus]++;
registrarPresencia(duracionTurnoMin);
historial.add(String.format("S%d %-9s OF %3d | a tiempo %3d (%3.0f%%) | faltan %3d%s | aus %d cob %d sin cubrir %d",
	semana + 1, nombreDia(dia), objetivo, aTiempo, objetivo > 0 ? 100.0 * aTiempo / objetivo : 100.0,
	faltante, detalle, ausentesHoy, coberturasHoy, vacantesCriticasHoy));
traceln(historial.get(historial.size() - 1));
cerrarMuestras();
dia++;
if (dia < diasPorSemana) iniciarJornada();
else iniciarRecuperacion();]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000236</Id>
						<Name><![CDATA[iniciarRecuperacion]]></Name>
						<X>3020</X>
						<Y>436</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[int pendientes = liberadasSemana - terminadasSemana;
if (pendientes <= 0) {
	pendientesSemana = 0;
	historial.add(String.format("S%d Fin de semana: no hace falta recuperar", semana + 1));
	traceln(historial.get(historial.size() - 1));
	finSemana();
	return;
}
// Jornada de recuperación: su OF es el faltante (unidades en proceso + sin iniciar)
enRecuperacion = true;
tInicioRecuperacion = time();
for (int m = 0; m < 5; m++) prodDia[m] = 0;
personasRecuperacion = convocarCuadrilla(pendientes);
asignarCoberturas();
ubicarOperarios();
pendientesInicioRecuperacion = pendientes;
eventoCierreJornada.restart(maxHorasRecuperacion * 60);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000237</Id>
						<Name><![CDATA[finRecuperacion]]></Name>
						<X>3020</X>
						<Y>458</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[if (!enRecuperacion) return;
eventoCierreJornada.reset();
eventoFinRecuperacion.reset();
double minutos = time() - tInicioRecuperacion;
// A la cuadrilla se le paga al menos horasMinimasRecuperacion
double horasPagadas = Math.max(minutos / 60.0, horasMinimasRecuperacion);
double horasHombre = horasPagadas * personasRecuperacion;
double costo = horasHombre * valorHoraNormal * recargoFinDeSemana;
registrarPresencia(minutos);
horasExtraTotal += horasHombre;
costoHorasExtraTotal += costo;
horasExtraSemana = horasHombre;
costoExtraSemana = costo;
pendientesSemana = pendientesInicioRecuperacion;
int sinRecuperar = liberadasSemana - terminadasSemana;
historial.add(String.format("S%d Fin de semana: %d pendientes, %d personas, %.1f h -> %.0f h-hombre ($ %,.0f)%s",
	semana + 1, pendientesInicioRecuperacion, personasRecuperacion, minutos / 60.0, horasHombre, costo,
	sinRecuperar > 0 ? " | quedan " + sinRecuperar + " para la semana siguiente" : ""));
traceln(historial.get(historial.size() - 1));
enRecuperacion = false;
cerrarMuestras();
finSemana();]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000238</Id>
						<Name><![CDATA[finSemana]]></Name>
						<X>3020</X>
						<Y>480</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[dsHorasExtraSemana.add(semana + 1, horasExtraSemana);
exportarSemana();
faltanteSemana = 0;
horasExtraSemana = 0;
costoExtraSemana = 0;
pendientesSemana = 0;
semana++;
liberadasSemana -= terminadasSemana; // lo no recuperado pasa a la semana siguiente
terminadasSemana = 0;
for (int m = 0; m < 5; m++) {
	ofSemana[m] = 0;
	prodSemana[m] = 0;
}
if (semana < semanasSimuladas) {
	dia = 0;
	iniciarJornada();
} else {
	simulacionTerminada = true;
	traceln(resumenTexto());
	exportarCorrida();
	if (detenerAlFinal) finishSimulation();
}]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
