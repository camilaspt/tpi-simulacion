for (int m = 0; m < 5; m++)
	s.append(String.format("%-10s inspec. %3d | rechazos %2d | stock %5d | t. sistema %6.1f min | espera %6.1f min%n",
		nombresModelo[m], inspeccionadas[m], rechazadas[m], enStock[m],
