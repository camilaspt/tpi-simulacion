					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000189</Id>
						<Name><![CDATA[construirPlanta]]></Name>
						<X>2800</X>
						<Y>62</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[if (plantaConstruida) return;
cargarRecetas();
nPuestos = 0;
for (int l = 0; l < columnasLinea.length; l++) columnasLinea[l] = 0;
nArmadoFijos = Math.max(1, Math.min(4, armadoresPorLinea));
// Líneas de Armado: puestos de armado (Celda 1) + ajuste (Celda 2/3)
for (int l = 0; l < lineasArmado; l++) {
	for (int k = 1; k <= armadoresPorLinea; k++)
		agregarPuesto(l, T_ARMADO, k <= nArmadoFijos ? k : 0);
	for (int k = 0; k < ajustadoresPorLinea; k++)
		agregarPuesto(l, T_AJUSTE, 0);
}
// Líneas de Control Final: control final + embalaje
for (int l = 0; l < lineasCF; l++) {
	int linea = lineasArmado + l;
	for (int k = 0; k < controladoresPorLineaCF; k++) agregarPuesto(linea, T_CONTROL, 0);
	for (int k = 0; k < embaladoresPorLineaCF; k++) agregarPuesto(linea, T_EMBALAJE, 0);
}
// Contrataciones: cada empleado nuevo agrega un puesto de su especialidad,
// repartido en forma rotativa entre las líneas que hacen esa tarea
for (int k = 0; k < extraArmadores && lineasArmado > 0; k++) agregarPuesto(k % lineasArmado, T_ARMADO, 0);
for (int k = 0; k < extraAjustadores && lineasArmado > 0; k++) agregarPuesto(k % lineasArmado, T_AJUSTE, 0);
for (int k = 0; k < extraControladores && lineasCF > 0; k++) agregarPuesto(lineasArmado + k % lineasCF, T_CONTROL, 0);
for (int k = 0; k < extraEmbaladores && lineasCF > 0; k++) agregarPuesto(lineasArmado + k % lineasCF, T_EMBALAJE, 0);
if (nPuestos > 36) traceln("Hay " + nPuestos + " puestos: el plano dibuja solo los primeros 36 (6 columnas de 6 mesas).");
plantaConstruida = true;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000190</Id>
						<Name><![CDATA[agregarPuesto]]></Name>
						<X>2800</X>
						<Y>84</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[linea]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[tipo]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[num]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[if (nPuestos >= pLinea.length || linea >= columnasLinea.length) {
	traceln("Se alcanzó el máximo de puestos del modelo; se ignora un puesto adicional.");
	return;
}
columnasLinea[linea]++;
int p = nPuestos++;
pLinea[p] = linea;
pTipo[p] = tipo;
pNum[p] = num;
pX[p] = posicionPuestoX(p);
pY[p] = posicionPuestoY(p);
pTitular[p] = -1;
pAtiende[p] = -1;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000191</Id>
						<Name><![CDATA[posicionPuestoX]]></Name>
						<X>2800</X>
						<Y>106</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[p]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[// Columnas de mesasPorColumna mesas; más de 6 columnas no entran en la nave, así que
// los puestos siguientes se intercalan entre las columnas existentes
int columna = p / mesasPorColumna;
return origenPuestosX + (columna % 6) * separacionColumnas + (columna / 6) * separacionColumnas / 2;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000192</Id>
						<Name><![CDATA[posicionPuestoY]]></Name>
						<X>2800</X>
						<Y>128</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[p]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[return origenPuestosY + (p % mesasPorColumna) * largoMesa;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000193</Id>
						<Name><![CDATA[pasoReceta]]></Name>
						<X>2800</X>
						<Y>150</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[m]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[tipo]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[num]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[tiempo]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Body><![CDATA[int k = recLen[m]++;
recTipo[m][k] = tipo;
recNum[m][k] = num;
recTiempo[m][k] = tiempo;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000194</Id>
						<Name><![CDATA[cargarRecetas]]></Name>
						<X>2800</X>
						<Y>172</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[// Valores relevados de SAP (los mismos de Datos/tiempos_proceso.csv), por si no se encuentra el archivo
for (int m = 0; m < 5; m++) {
	recLen[m] = 0;
	tiempoRetiro[m] = 2;
}
pasoReceta(0, T_ARMADO, 1, 3.5); pasoReceta(0, T_ARMADO, 2, 7); pasoReceta(0, T_ARMADO, 3, 7); pasoReceta(0, T_ARMADO, 4, 7.5);
pasoReceta(0, T_AJUSTE, 0, 5); pasoReceta(0, T_CONTROL, 0, 4.5); pasoReceta(0, T_EMBALAJE, 0, 10);
pasoReceta(1, T_ARMADO, 0, 11); pasoReceta(1, T_AJUSTE, 0, 12); pasoReceta(1, T_CONTROL, 0, 12); pasoReceta(1, T_EMBALAJE, 0, 12);
pasoReceta(2, T_ARMADO, 0, 3.15); pasoReceta(2, T_AJUSTE, 0, 3); pasoReceta(2, T_CONTROL, 0, 2.25); pasoReceta(2, T_EMBALAJE, 0, 3);
pasoReceta(3, T_AJUSTE, 0, 4); pasoReceta(3, T_CONTROL, 0, 3.15); pasoReceta(3, T_EMBALAJE, 0, 3.15);
pasoReceta(4, T_ARMADO, 0, 3.15); pasoReceta(4, T_AJUSTE, 0, 3); pasoReceta(4, T_CONTROL, 0, 2.5); pasoReceta(4, T_EMBALAJE, 0, 2.88);
fuenteTiempos = "valores SAP cargados en el modelo";

java.io.File archivo = new java.io.File("Datos/tiempos_proceso.csv");
if (!archivo.exists()) {
	traceln("No se encontró Datos/tiempos_proceso.csv; se usan los tiempos cargados en el modelo.");
	return;
}
int[] largo = new int[5];
int[][] tipos = new int[5][12];
int[][] nums = new int[5][12];
double[][] tiempos = new double[5][12];
double[] retiro = { 2, 2, 2, 2, 2 };
try (java.io.BufferedReader lector = new java.io.BufferedReader(new java.io.InputStreamReader(
		new java.io.FileInputStream(archivo), java.nio.charset.StandardCharsets.UTF_8))) {
	String fila = lector.readLine(); // encabezado
	while ((fila = lector.readLine()) != null) {
		String[] c = fila.split(";");
		if (c.length < 7) continue;
		int m = indiceModelo(c[0]);
		if (m < 0) continue;
		double t = Double.parseDouble(c[6].trim().replace(',', '.'));
		String celda = c[3].trim().toUpperCase();
		String puesto = c[4].trim().toUpperCase();
		String tarea = c[5].trim().toUpperCase();
		if (c[2].trim().toUpperCase().startsWith("DEPOSITO")) {
			retiro[m] = t; // solo el retiro en el rack; las caminatas salen del modelo
			continue;
		}
		int tipo;
		if (celda.startsWith("EMBALAJE")) tipo = T_EMBALAJE;
		else if (celda.startsWith("CONTROL")) tipo = T_CONTROL;
		else if (tarea.startsWith("AJUSTADOR")) tipo = T_AJUSTE; // Celda 2 y Celda 3 (REPORT LT)
		else tipo = T_ARMADO;
		int num = 0;
		int i = puesto.indexOf("PUESTO ");
		if (tipo == T_ARMADO && i >= 0) num = Integer.parseInt(puesto.substring(i + 7).trim());
		if (largo[m] >= 12) continue;
		tipos[m][largo[m]] = tipo;
		nums[m][largo[m]] = num;
		tiempos[m][largo[m]] = t;
		largo[m]++;
	}
} catch (Exception e) {
	traceln("No se pudo leer Datos/tiempos_proceso.csv (" + e.getMessage() + "); se usan los tiempos cargados en el modelo.");
	return;
}
for (int m = 0; m < 5; m++) if (largo[m] == 0) return;
for (int m = 0; m < 5; m++) {
	recLen[m] = largo[m];
	tiempoRetiro[m] = retiro[m];
	for (int k = 0; k < largo[m]; k++) {
		recTipo[m][k] = tipos[m][k];
		recNum[m][k] = nums[m][k];
		recTiempo[m][k] = tiempos[m][k];
	}
}
fuenteTiempos = "Datos/tiempos_proceso.csv";]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[int]]></ReturnType>
						<Id>1796000000195</Id>
						<Name><![CDATA[indiceModelo]]></Name>
						<X>2800</X>
						<Y>194</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[nombre]]></Name>
							<Type><![CDATA[String]]></Type>
						</Parameter>
						<Body><![CDATA[String u = nombre.toUpperCase();
if (u.contains("AILA")) return 0;
if (u.contains("REPORT")) return 1;
if (u.contains("NOVEL")) return 2;
if (u.contains("LURA")) return 3;
if (u.contains("AURA")) return 4;
return -1;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[Especialidad]]></ReturnType>
						<Id>1796000000196</Id>
						<Name><![CDATA[especialidadDeTipo]]></Name>
						<X>2800</X>
						<Y>216</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[tipo]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[if (tipo == T_ARMADO) return Especialidad.Armador;
if (tipo == T_AJUSTE) return Especialidad.Ajustador;
if (tipo == T_CONTROL) return Especialidad.Controlador;
return Especialidad.Embalador;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000197</Id>
						<Name><![CDATA[registrarOperario]]></Name>
						<X>2800</X>
						<Y>238</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[construirPlanta();
o.idOp = ops.size();
ops.add(o);
o.setSpeed(velocidadOperario, MPS);
if (o.idOp < nPuestos) {
	// Titular de un puesto: su especialidad sale del tipo de puesto
	int p = o.idOp;
	o.puestoHabitual = p;
	o.lineaHabitual = pLinea[p];
	o.esReserva = false;
	o.especialidad = especialidadDeTipo(pTipo[p]);
	pTitular[p] = o.idOp;
} else {
	o.puestoHabitual = -1;
	o.lineaHabitual = -1;
	o.esReserva = true;
	o.especialidad = Especialidad.Polivalente;
}]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[int]]></ReturnType>
						<Id>1796000000198</Id>
						<Name><![CDATA[ofEjemplo]]></Name>
						<X>2800</X>
						<Y>260</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[of]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[m]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[// OF de ejemplo (reemplazar por OF reales de KRETZ cuando estén disponibles). Escaladas un 15,5 %
// para que, como en la planta, haya que recuperar el sábado en 3 de cada 4 semanas
// (calibración con 30 réplicas: 266 u/día -> 29 % de las semanas; 298 -> 55 %; 325 -> 100 %).
int[][] ejemplos = {
	{ 42, 58, 83, 55, 69 },   // OF 1: mezcla equilibrada (307 unidades)
	{ 28, 83, 55, 42, 55 },   // OF 2: mucha REPORT LT (procesos largos)
	{ 55, 35, 111, 69, 83 }   // OF 3: alto volumen de equipos cortos
};
if (of == 0) {
	int[] propia = { cantidadAILA, cantidadREPORT, cantidadNOVEL, cantidadLURA, cantidadAURA };
	return propia[m];
}
if (of == 4) return ejemplos[(diaGlobal - 1) % 3][m];
return ejemplos[Math.max(1, Math.min(3, of)) - 1][m];]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000199</Id>
						<Name><![CDATA[tiempoTotalModelo]]></Name>
						<X>2800</X>
						<Y>282</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[m]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[double total = tiempoRetiro[m];
for (int k = 0; k < recLen[m]; k++) total += recTiempo[m][k];
return total;]]></Body>
					</Function>
