					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[long]]></ReturnType>
						<Id>1796000000687</Id>
						<Name><![CDATA[mezclar]]></Name>
						<X>3020</X>
						<Y>84</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[z]]></Name>
							<Type><![CDATA[long]]></Type>
						</Parameter>
						<Body><![CDATA[// Mezclador de SplitMix64: convierte una clave en un número pseudoaleatorio de 64 bits
z = (z ^ (z >>> 30)) * 0xBF58476D1CE4E5B9L;
z = (z ^ (z >>> 27)) * 0x94D049BB133111EBL;
return z ^ (z >>> 31);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000688</Id>
						<Name><![CDATA[azar]]></Name>
						<X>3020</X>
						<Y>106</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[flujo]]></Name>
							<Type><![CDATA[long]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[a]]></Name>
							<Type><![CDATA[long]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[long]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[c]]></Name>
							<Type><![CDATA[long]]></Type>
						</Parameter>
						<Body><![CDATA[// Uniforme en [0, 1) que depende solo de la semilla de la corrida y de la clave (flujo, a, b, c).
// Así el mismo sorteo (por ejemplo, si el titular del puesto 7 falta el día 12) da igual en todos
// los escenarios con la misma semilla, sin importar el orden de los eventos: números aleatorios comunes.
long z = mezclar(semillaUsada * 0x9E3779B97F4A7C15L + flujo);
z = mezclar(z + a);
z = mezclar(z + b);
z = mezclar(z + c);
return (z >>> 11) * 0x1.0p-53;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000689</Id>
						<Name><![CDATA[triangularInversa]]></Name>
						<X>3020</X>
						<Y>128</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[min]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[max]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[moda]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[u]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Body><![CDATA[// Inversa de la distribución triangular: transforma una uniforme u en un tiempo
double fc = (moda - min) / (max - min);
if (u < fc) return min + Math.sqrt(u * (max - min) * (moda - min));
return max - Math.sqrt((1 - u) * (max - min) * (max - moda));]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000690</Id>
						<Name><![CDATA[tiempoConAzar]]></Name>
						<X>3020</X>
						<Y>150</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[media]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[u]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Body><![CDATA[// Triangular asimétrica con la media de SAP: mín 0,8·m, moda 0,9·m, máx 1,3·m (para variabilidad 1)
double k = Math.max(0, Math.min(3, variabilidadTiempos));
if (k == 0 || media <= 0) return media;
return triangularInversa(media * (1 - 0.2 * k), media * (1 + 0.3 * k), media * (1 - 0.1 * k), u);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[int]]></ReturnType>
						<Id>1796000000694</Id>
						<Name><![CDATA[claveOperario]]></Name>
						<X>3020</X>
						<Y>172</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[// Clave estable para sortear la asistencia: el puesto del titular o el número de la reserva
return o.puestoHabitual >= 0 ? o.puestoHabitual : 1000 + o.idOp - nPuestos;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[int]]></ReturnType>
						<Id>1796000000706</Id>
						<Name><![CDATA[convocarCuadrilla]]></Name>
						<X>3020</X>
						<Y>194</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[pendientes]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[// Cuadrilla proporcional al faltante: una persona cada unidadesPorPersonaRecuperacion pendientes,
// entre minCuadrillaRecuperacion y maxCuadrillaRecuperacion. Se reparte entre las especialidades
// según los minutos de trabajo pendientes de cada una (al menos una por especialidad con trabajo).
int convocados = (int) Math.ceil(pendientes / Math.max(1e-9, unidadesPorPersonaRecuperacion));
convocados = Math.max(minCuadrillaRecuperacion, Math.min(maxCuadrillaRecuperacion, convocados));
double[] carga = new double[4];
for (int m = 0; m < 5; m++) {
	if (enSistemaModelo[m] <= 0 || recLen[m] == 0) continue;
	carga[recTipo[m][0]] += enSistemaModelo[m] * tiempoRetiro[m];
	for (int k = 0; k < recLen[m]; k++) carga[recTipo[m][k]] += enSistemaModelo[m] * recTiempo[m][k];
}
int necesarias = 0;
double total = 0;
for (int t = 0; t < 4; t++) if (carga[t] > 0) { necesarias++; total += carga[t]; }
convocados = Math.max(convocados, necesarias);
// Reparto por restos mayores, con mínimo 1 para cada especialidad con trabajo
int[] cupo = new int[4];
double[] resto = new double[4];
int asignados = 0;
for (int t = 0; t < 4; t++) {
	if (carga[t] <= 0) continue;
	double ideal = convocados * carga[t] / total;
	cupo[t] = Math.max(1, (int) Math.floor(ideal));
	resto[t] = ideal - Math.floor(ideal);
	asignados += cupo[t];
}
while (asignados < convocados) {
	int mejor = -1;
	for (int t = 0; t < 4; t++) if (carga[t] > 0 && (mejor < 0 || resto[t] > resto[mejor])) mejor = t;
	if (mejor < 0) break;
	cupo[mejor]++;
	resto[mejor] = -1;
	asignados++;
}
// Se convoca a los titulares de cada especialidad en orden de línea (la cuadrilla queda concentrada);
// quien no asiste se reemplaza por el siguiente. La reserva no se convoca.
ausentesHoy = 0;
for (Operario o : ops) o.presente = false;
int presentes = 0;
for (int t = 0; t < 4; t++) {
	Especialidad e = especialidadDeTipo(t);
	int vienen = 0;
	for (Operario o : ops) {
		if (vienen >= cupo[t]) break;
		if (o.esReserva || o.especialidad != e) continue;
		if (azar(2, diaGlobal, claveOperario(o), 0) >= probAusenciaFinDeSemana) {
			o.presente = true;
			vienen++;
		} else {
			ausentesHoy++;
		}
	}
	presentes += vienen;
}
return presentes;]]></Body>
					</Function>
				</Functions>
