				<BeforeEachExperimentRunCode><![CDATA[dsCostoReplica.reset();
dsCostoReplicaMedia.reset();
dsCostoReplicaSup.reset();
dsCostoReplicaInf.reset();
dsCumplimientoReplica.reset();
dsCumplimientoReplicaMedia.reset();
dsCumplimientoReplicaSup.reset();
dsCumplimientoReplicaInf.reset();
dsHorasExtraReplica.reset();
dsHorasExtraReplicaMedia.reset();
dsHorasExtraReplicaSup.reset();
dsHorasExtraReplicaInf.reset();]]></BeforeEachExperimentRunCode>
				<AfterSimulationRunCode><![CDATA[// Cada réplica que termina suma su valor y actualiza la media acumulada y su IC del 95 %
// (x = réplicas terminadas: muestra cómo se estabiliza el resultado al sumar réplicas)
double[] t95 = { 12.706, 4.303, 3.182, 2.776, 2.571, 2.447, 2.365, 2.306, 2.262, 2.228, 2.201, 2.179, 2.160, 2.145, 2.131, 2.120, 2.110, 2.101, 2.093, 2.086, 2.080, 2.074, 2.069, 2.064, 2.060, 2.056, 2.052, 2.048, 2.045, 2.042 };
{
	dsCostoReplica.add(dsCostoReplica.size() + 1, root.costoTotal() / 1e6);
	int k = dsCostoReplica.size();
	double suma = 0, suma2 = 0;
	for (int i = 0; i < k; i++) { double y = dsCostoReplica.getY(i); suma += y; suma2 += y * y; }
	double media = suma / k;
	double semi = k > 1 ? (k - 1 <= t95.length ? t95[k - 2] : 1.96)
		* Math.sqrt(Math.max(0, (suma2 - k * media * media) / (k - 1)) / k) : 0;
	dsCostoReplicaMedia.add(k, media);
	dsCostoReplicaSup.add(k, media + semi);
	dsCostoReplicaInf.add(k, media - semi);
}
{
	dsCumplimientoReplica.add(dsCumplimientoReplica.size() + 1, 100 * root.cumplimientoTotal());
	int k = dsCumplimientoReplica.size();
	double suma = 0, suma2 = 0;
	for (int i = 0; i < k; i++) { double y = dsCumplimientoReplica.getY(i); suma += y; suma2 += y * y; }
	double media = suma / k;
	double semi = k > 1 ? (k - 1 <= t95.length ? t95[k - 2] : 1.96)
		* Math.sqrt(Math.max(0, (suma2 - k * media * media) / (k - 1)) / k) : 0;
	dsCumplimientoReplicaMedia.add(k, media);
	dsCumplimientoReplicaSup.add(k, media + semi);
	dsCumplimientoReplicaInf.add(k, media - semi);
}
{
	dsHorasExtraReplica.add(dsHorasExtraReplica.size() + 1, root.horasExtraTotal);
	int k = dsHorasExtraReplica.size();
	double suma = 0, suma2 = 0;
	for (int i = 0; i < k; i++) { double y = dsHorasExtraReplica.getY(i); suma += y; suma2 += y * y; }
	double media = suma / k;
	double semi = k > 1 ? (k - 1 <= t95.length ? t95[k - 2] : 1.96)
		* Math.sqrt(Math.max(0, (suma2 - k * media * media) / (k - 1)) / k) : 0;
	dsHorasExtraReplicaMedia.add(k, media);
	dsHorasExtraReplicaSup.add(k, media + semi);
	dsHorasExtraReplicaInf.add(k, media - semi);
}]]></AfterSimulationRunCode>
				<AfterExperimentCode><![CDATA[traceln(String.format("%s: %d réplicas | costo medio $ %,.2f M | cumplimiento medio %.1f %%", "Escenario actual", dsCostoReplica.size(), dsCostoReplica.getYMean(), dsCumplimientoReplica.getYMean()));
traceln("Resultados en Resultados/resultados_corridas.csv: analizalos con scripts/analizar_resultados.py");]]></AfterExperimentCode>
