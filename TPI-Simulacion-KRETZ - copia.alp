					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[double]]></ReturnType>
						<Id>1796000000717</Id>
						<Name><![CDATA[efectoAusencias]]></Name>
						<X>3020</X>
						<Y>62</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[// Diferencia de faltante entre jornadas con y sin ausencias, comparando cada día de la semana
// consigo mismo (el atraso se acumula de lunes a viernes, así que mezclar días confunde).
// Se promedia ponderando por las jornadas con ausencias de cada día.
double suma = 0, peso = 0;
for (int d = 0; d < 7; d++) {
	int nCon = jornadasDiaAus[d][0], nSin = jornadasDiaAus[d][1];
	if (nCon == 0 || nSin == 0) continue;
	suma += nCon * (faltanteDiaAus[d][0] / nCon - faltanteDiaAus[d][1] / nSin);
	peso += nCon;
}
return peso > 0 ? suma / peso : 0;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[int]]></ReturnType>
						<Id>1796000000718</Id>
						<Name><![CDATA[jornadasComparables]]></Name>
						<X>3020</X>
						<Y>84</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[// Jornadas de los días de la semana que tuvieron tanto jornadas con ausencias como sin ellas
int n = 0;
for (int d = 0; d < 7; d++)
	if (jornadasDiaAus[d][0] > 0 && jornadasDiaAus[d][1] > 0) n += jornadasDiaAus[d][0] + jornadasDiaAus[d][1];
return n;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[String]]></ReturnType>
						<Id>1796000000719</Id>
						<Name><![CDATA[textoAusencias]]></Name>
						<X>3020</X>
						<Y>106</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[StringBuilder s = new StringBuilder(String.format("%-10s %22s %22s %12s%n", "Día", "Con ausencias (n)", "Sin ausencias (n)", "Diferencia"));
for (int d = 0; d < 7; d++) {
	int nCon = jornadasDiaAus[d][0], nSin = jornadasDiaAus[d][1];
	if (nCon + nSin == 0) continue;
	String con = nCon > 0 ? String.format("%.1f u. (%d)", faltanteDiaAus[d][0] / nCon, nCon) : "- (0)";
	String sin = nSin > 0 ? String.format("%.1f u. (%d)", faltanteDiaAus[d][1] / nSin, nSin) : "- (0)";
	String dif = nCon > 0 && nSin > 0 ? String.format("%+.1f u.", faltanteDiaAus[d][0] / nCon - faltanteDiaAus[d][1] / nSin) : "s/d";
	s.append(String.format("%-10s %22s %22s %12s%n", nombreDia(d), con, sin, dif));
}
if (jornadasComparables() > 0)
	s.append(String.format("Efecto medio: %+.1f u. de faltante en las jornadas con ausencias (%d jornadas comparables)",
		efectoAusencias(), jornadasComparables()));
else
	s.append("Efecto medio: s/d (ningún día de la semana tuvo jornadas con y sin ausencias; usar las réplicas)");
return s.toString();]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[long]]></ReturnType>
						<Id>1796000000691</Id>
						<Name><![CDATA[semillaDeReplica]]></Name>
						<X>3020</X>
						<Y>40</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[r]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[// Listado común de semillas: la réplica r usa la misma semilla en todos los escenarios
// (números aleatorios comunes). Se generó una vez, al azar, y queda fijo.
long[] lista = {
	227904006L, 443043868L, 639572182L, 649565454L, 794923749L, 210205473L, 339749960L, 745351751L,
	767313473L, 697600698L, 551631864L, 941140765L, 714791075L, 688208069L, 884410270L, 933838458L,
	924757551L, 627104586L, 906407983L, 930080574L, 729771961L, 573622146L, 357627256L, 102721764L,
	759496827L, 186676380L, 218902461L, 408421828L, 976990827L, 205282126L };
if (r >= 1 && r <= lista.length) return lista[r - 1];
// Más réplicas que el listado: una semilla fija que depende solo del número de réplica
return 1 + Math.floorMod(new java.util.Random(7919L * r).nextLong(), 999999999L);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[int]]></ReturnType>
						<Id>1796000000646</Id>
						<Name><![CDATA[limitePuestos]]></Name>
						<X>3020</X>
						<Y>40</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[// En la recuperación de fin de semana la cuadrilla es chica: cada uno puede atender más puestos
return enRecuperacion ? Math.max(maxPuestosPorOperario, 4) : maxPuestosPorOperario;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
