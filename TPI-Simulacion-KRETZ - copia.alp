					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000202</Id>
						<Name><![CDATA[iniciarJornada]]></Name>
						<X>2800</X>
						<Y>348</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[// Los operarios los crea el ResourcePool; si todavía no están, se reintenta enseguida
if (ops.size() < nPuestos + operariosReserva) {
	eventoInicioJornada.restart(0.01);
	return;
}
enRecuperacion = false;
diaGlobal++;
tInicioJornada = time();
for (int m = 0; m < 5; m++) {
	contadorModeloDia[m] = 0;
	ofDia[m] = ofEjemplo(ofSeleccionada, m);
	ofSemana[m] += ofDia[m];
	ofTotal[m] += ofDia[m];
	prodDia[m] = 0;
	aTiempoDia[m] = 0;
}
asignarAsistencia(Math.min(1, probAusencia * factorAusenciaDia[dia % 5]));
asignarCoberturas();
ubicarOperarios();
liberarUnidadesOF();
eventoCierreJornada.restart(duracionTurnoMin);
eventoCamion1.restart(horaCamion1Min);
eventoCamion2.restart(horaCamion2Min);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000203</Id>
						<Name><![CDATA[asignarAsistencia]]></Name>
						<X>2800</X>
						<Y>370</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[prob]]></Name>
							<Type><![CDATA[double]]></Type>
						</Parameter>
						<Body><![CDATA[// Cada persona tiene su propio sorteo por día (números aleatorios comunes entre escenarios)
ausentesHoy = 0;
for (Operario o : ops) {
	o.presente = azar(1, diaGlobal, claveOperario(o), 0) >= prob;
	if (!o.presente) ausentesHoy++;
}]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000204</Id>
						<Name><![CDATA[asignarCoberturas]]></Name>
						<X>2800</X>
						<Y>392</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[for (int p = 0; p < nPuestos; p++) pAtiende[p] = -1;
for (Operario o : ops) {
	o.puestosAtendidos.clear();
	if (o.presente && o.puestoHabitual >= 0) {
		pAtiende[o.puestoHabitual] = o.idOp;
		o.puestosAtendidos.add(o.puestoHabitual);
	}
}
vacantesHoy = 0;
coberturasHoy = 0;
vacantesCriticasHoy = 0;
for (int p = 0; p < nPuestos; p++) if (pAtiende[p] < 0) vacantesHoy++;
// Se cubren los puestos vacantes que frenan la línea (ningún otro puesto
// atendido de esa línea puede hacer la tarea). Quien cubre conserva su puesto
// y reparte su tiempo entre los dos: traslada el cuello de botella.
for (int p = 0; p < nPuestos; p++) {
	if (pAtiende[p] >= 0 || !esPuestoCritico(p)) continue;
	Operario c = buscarCobertura(p);
	if (c != null) {
		pAtiende[p] = c.idOp;
		c.puestosAtendidos.add(p);
		coberturasHoy++;
	} else {
		vacantesCriticasHoy++;
	}
}
// La reserva que quedó libre cubre también los puestos vacantes no críticos (por ejemplo, un
// controlador o un embalador), empezando por las tareas más cargadas
int[] ordenTipos = { T_AJUSTE, T_CONTROL, T_EMBALAJE, T_ARMADO };
for (int t : ordenTipos)
	for (int p = 0; p < nPuestos; p++) {
		if (pAtiende[p] >= 0 || pTipo[p] != t) continue;
		Operario r = reservaLibre();
		if (r == null) break;
		pAtiende[p] = r.idOp;
		r.puestosAtendidos.add(p);
		coberturasHoy++;
	}
if (!enRecuperacion) {
	coberturasTotal += coberturasHoy;
	vacantesCriticasTotal += vacantesCriticasHoy;
	minutosVacantesTotal += (vacantesHoy - coberturasHoy) * duracionTurnoMin;
}
// Qué líneas pueden completar cada modelo con el personal de hoy
for (int l = 0; l < lineasArmado + lineasCF && l < lineaCapaz.length; l++)
	for (int m = 0; m < 5; m++) {
		lineaCapaz[l][m][0] = l < lineasArmado && lineaPuedeProcesar(l, m, true);
		lineaCapaz[l][m][1] = l >= lineasArmado && lineaPuedeProcesar(l, m, false);
	}
tomarOperario.recalculateResourceChoiceConditions();]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[boolean]]></ReturnType>
						<Id>1796000000205</Id>
						<Name><![CDATA[esPuestoCritico]]></Name>
						<X>2800</X>
						<Y>414</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[p]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[// Un puesto es crítico si ningún otro puesto atendido de su línea puede hacer su tarea
for (int q = 0; q < nPuestos; q++) {
	if (q == p || pAtiende[q] < 0 || pLinea[q] != pLinea[p] || pTipo[q] != pTipo[p]) continue;
	if (pTipo[p] != T_ARMADO || pNum[p] == 0 || pNum[q] == 0 || pNum[q] == pNum[p]) return false;
}
return true;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[boolean]]></ReturnType>
						<Id>1796000000206</Id>
						<Name><![CDATA[puedeCubrir]]></Name>
						<X>2800</X>
						<Y>436</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[return o.presente && !o.esReserva && !o.puestosAtendidos.isEmpty()
	&& o.puestosAtendidos.size() < limitePuestos();]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[int]]></ReturnType>
						<Id>1796000000207</Id>
						<Name><![CDATA[cargaCobertura]]></Name>
						<X>2800</X>
						<Y>458</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[o]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[// Menor es mejor: primero quien atiende menos puestos y cuyo puesto propio tiene respaldo
int carga = o.puestosAtendidos.size() * 2;
if (o.puestoHabitual >= 0 && esPuestoCritico(o.puestoHabitual)) carga++;
return carga;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[Operario]]></ReturnType>
						<Id>1796000000208</Id>
						<Name><![CDATA[mejorCandidato]]></Name>
						<X>2800</X>
						<Y>480</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[actual]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Parameter>
							<Name><![CDATA[candidato]]></Name>
							<Type><![CDATA[Operario]]></Type>
						</Parameter>
						<Body><![CDATA[if (actual == null) return candidato;
return cargaCobertura(candidato) < cargaCobertura(actual) ? candidato : actual;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[Operario]]></ReturnType>
						<Id>1796000000209</Id>
						<Name><![CDATA[buscarCobertura]]></Name>
						<X>2800</X>
						<Y>502</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[p]]></Name>
							<Type><![CDATA[int]]></Type>
						</Parameter>
						<Body><![CDATA[Especialidad e = especialidadDeTipo(pTipo[p]);
int linea = pLinea[p];
boolean lineaDeArmado = linea < lineasArmado;
// 0) Personal de reserva polivalente libre (no deja ningún puesto)
Operario libre = reservaLibre();
if (libre != null) return libre;
Operario mejor = null;
// 1) Misma especialidad y misma línea
for (Operario o : ops)
	if (puedeCubrir(o) && o.especialidad == e && o.lineaHabitual == linea) mejor = mejorCandidato(mejor, o);
if (mejor != null) return mejor;
// 1b) Con cobertura entre especialidades: otra especialidad de la misma línea, antes de que
// alguien de la misma especialidad tenga que atender puestos de dos líneas
if (coberturaEntreEspecialidades) {
	for (Operario o : ops)
		if (puedeCubrir(o) && o.lineaHabitual == linea) mejor = mejorCandidato(mejor, o);
	if (mejor != null) return mejor;
}
// 2) Misma especialidad, otra línea del mismo tipo
for (Operario o : ops)
	if (puedeCubrir(o) && o.especialidad == e && (o.lineaHabitual < lineasArmado) == lineaDeArmado) mejor = mejorCandidato(mejor, o);
if (mejor != null) return mejor;
// 3) Los puestos de armado los puede cubrir cualquier operario (primero de la misma línea)
if (pTipo[p] == T_ARMADO || coberturaEntreEspecialidades) {
	for (Operario o : ops)
		if (puedeCubrir(o) && o.lineaHabitual == linea) mejor = mejorCandidato(mejor, o);
	if (mejor != null) return mejor;
	for (Operario o : ops)
		if (puedeCubrir(o)) mejor = mejorCandidato(mejor, o);
}
return mejor;]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000210</Id>
						<Name><![CDATA[asegurarEspacio]]></Name>
						<X>2800</X>
						<Y>524</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[a]]></Name>
							<Type><![CDATA[Agent]]></Type>
						</Parameter>
						<Body><![CDATA[// El ResourcePool y la Source crean a operarios y unidades sin espacio asignado;
// como el modelo los mueve por código, se los incorpora al espacio y nivel de Main
if (a.getSpace() == null) a.setSpace(this);
if (a.getLevel() == null) a.setLevel(level);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000211</Id>
						<Name><![CDATA[ubicarOperarios]]></Name>
						<X>2800</X>
						<Y>546</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[int ausentes = 0, reservas = 0;
for (Operario o : ops) asegurarEspacio(o);
for (Operario o : ops) {
	if (o.estado != 0) continue; // quien está trabajando termina su tarea donde está
	if (!o.presente) {
		o.jumpTo(zonaAusentesX + (ausentes % 10) * 14, zonaAusentesY + (ausentes / 10) * 14);
		ausentes++;
	} else if (!o.puestosAtendidos.isEmpty()) {
		int p = o.puestosAtendidos.get(0);
		o.jumpTo(pX[p], pY[p]);
	} else {
		o.jumpTo(zonaReservaX + (reservas % 5) * 14, zonaReservaY);
		reservas++;
	}
}]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000212</Id>
						<Name><![CDATA[liberarUnidadesOF]]></Name>
						<X>2800</X>
						<Y>568</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[java.util.ArrayList<Integer> orden = new java.util.ArrayList<Integer>();
Integer[] modelos = { 0, 1, 2, 3, 4 };
if (reglaSecuencia == 1)
	java.util.Arrays.sort(modelos, (a, b) -> Double.compare(tiempoTotalModelo(b), tiempoTotalModelo(a)));
else if (reglaSecuencia == 2)
	java.util.Arrays.sort(modelos, (a, b) -> Double.compare(tiempoTotalModelo(a), tiempoTotalModelo(b)));
if (reglaSecuencia == 3) {
	// Intercalado: un equipo de cada modelo por vuelta
	int[] resto = ofDia.clone();
	boolean quedan = true;
	while (quedan) {
		quedan = false;
		for (int m = 0; m < 5; m++)
			if (resto[m] > 0) {
				orden.add(m);
				resto[m]--;
				quedan = true;
			}
	}
} else {
	for (int m : modelos)
		for (int k = 0; k < ofDia[m]; k++) orden.add(m);
}
colaLiberacion.addAll(orden);
liberadasSemana += orden.size();
fuenteOF.inject(orden.size());]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>VOID</ReturnModificator>
						<ReturnType><![CDATA[void]]></ReturnType>
						<Id>1796000000213</Id>
						<Name><![CDATA[prepararUnidad]]></Name>
						<X>2800</X>
						<Y>590</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Parameter>
							<Name><![CDATA[b]]></Name>
							<Type><![CDATA[Balanza]]></Type>
						</Parameter>
						<Body><![CDATA[int m = colaLiberacion.isEmpty() ? 0 : colaLiberacion.removeFirst();
b.tipoModelo = m;
b.set_modelo(nombresModelo[m]);
b.paso = 0;
b.lineaArmado = -1;
b.lineaCF = -1;
b.tIngreso = time();
b.diaOF = diaGlobal;
b.ordenLiberacion = contadorLiberadas++;
b.nroEnModelo = contadorModeloDia[m]++;
enSistemaModelo[m]++;
enProceso++;
// La caja del kit entra al rack de materiales cuando hay una celda libre (areaKitsInicio) y queda
// ahí hasta que el operario la retira; mientras espera lugar no se dibuja
asegurarEspacio(b);
b.color = colorModelo(m);
b.mostrarCaja = false;]]></Body>
					</Function>
