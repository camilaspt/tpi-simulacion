				<Functions>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[Color]]></ReturnType>
						<Id>1796000000532</Id>
						<Name><![CDATA[colorEstado]]></Name>
						<X>300</X>
						<Y>90</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[// Relleno según el estado del operario
if (!presente) return new Color(205, 60, 60);
if (estado == 2) return new Color(30, 150, 75);
if (estado == 1) return new Color(240, 180, 30);
return new Color(160, 168, 180);]]></Body>
					</Function>
					<Function AccessType="public" StaticFunction="false">
						<ReturnModificator>RETURNS_VALUE</ReturnModificator>
						<ReturnType><![CDATA[Color]]></ReturnType>
						<Id>1796000000533</Id>
						<Name><![CDATA[colorEspecialidad]]></Name>
						<X>300</X>
						<Y>112</Y>
						<Label>
							<X>10</X>
							<Y>0</Y>
						</Label>
						<PublicFlag>false</PublicFlag>
						<PresentationFlag>true</PresentationFlag>
						<ShowLabel>true</ShowLabel>
						<Body><![CDATA[// Borde según la especialidad
if (especialidad == Especialidad.Armador) return new Color(37, 99, 235);
if (especialidad == Especialidad.Ajustador) return new Color(147, 51, 234);
if (especialidad == Especialidad.Controlador) return new Color(13, 148, 136);
if (especialidad == Especialidad.Embalador) return new Color(180, 83, 9);
return new Color(15, 23, 42);]]></Body>
					</Function>
				</Functions>
